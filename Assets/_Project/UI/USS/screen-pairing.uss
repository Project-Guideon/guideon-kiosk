/* Pairing Screen — 페어링 코드 등록 (UNITY_DESIGN_SPEC §3.2) */

.pairing-root {
    flex-direction: column;
}

/* ── 좌측 안내 패널 (680px) ── */
.pairing-left {
    width: 680px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 80px;
    background-color: rgba(245, 237, 224, 0.7);
    border-right-width: 1px;
    border-right-color: rgba(90, 60, 20, 0.12);
}

.pairing-title {
    font-size: 32px;
    color: rgb(26, 18, 8);
    -unity-font-style: bold;
    margin-top: 24px;
    -unity-text-align: upper-left;
}

.pairing-desc {
    font-size: 17px;
    color: rgb(74, 53, 32);
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.pairing-step-row {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    width: 100%;
}

.pairing-step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(200, 64, 48, 0.1);
    border-width: 1.5px;
    border-color: rgb(177, 74, 46);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 20px;
}

.pairing-step-num-text {
    font-size: 15px;
    color: rgb(177, 74, 46);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pairing-step-text {
    font-size: 16px;
    color: rgb(74, 53, 32);
    white-space: normal;
}

.pairing-expire-hint {
    font-size: 14px;
    color: rgb(138, 112, 96);
    margin-top: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── 우측 코드 영역 (flex 1) ── */
.pairing-right {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* 코드 카드 */
.pairing-code-card {
    flex-direction: column;
    align-items: center;
    padding: 64px 100px;
    background-color: rgba(255, 252, 245, 0.92);
    border-width: 2px;
    border-color: rgba(90, 60, 20, 0.15);
    border-radius: 24px;
    overflow: hidden;
    position: relative;
}

.pairing-code-label {
    font-size: 20px;
    color: rgb(138, 112, 96);
    letter-spacing: 6px;
    margin-bottom: 48px;
    -unity-text-align: middle-center;
}

/* 6자리 코드 박스 행 */
.code-box-row {
    flex-direction: row;
    align-items: center;
}

.code-box {
    width: 110px;
    height: 140px;
    background-color: rgba(200, 64, 48, 0.06);
    border-width: 2px;
    border-color: rgba(200, 64, 48, 0.25);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    margin: 0 12px;
}

.code-box__digit {
    font-size: 80px;
    color: rgb(177, 74, 46);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 타이머 그룹 */
.timer-group {
    flex-direction: column;
    align-items: center;
    margin-top: 48px;
}

.timer-text {
    font-size: 17px;
    color: rgb(74, 53, 32);
    -unity-text-align: middle-center;
}

.timer-countdown {
    font-size: 22px;
    color: rgb(177, 74, 46);
    -unity-font-style: bold;
    margin: 0 4px;
}

.timer-track {
    width: 520px;
    height: 4px;
    background-color: rgba(200, 64, 48, 0.08);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 12px;
}

.timer-fill {
    height: 4px;
    background-color: rgb(177, 74, 46);
    border-radius: 4px;
    transition: width 1s;
}

/* 하단 안내 */
.pairing-footer-hint {
    font-size: 18px;
    color: rgb(138, 112, 96);
    margin-top: 40px;
    -unity-text-align: middle-center;
}


