/* Chat Screen — 일반 대화 (UNITY_DESIGN_SPEC §3.5) */

.chat-root {
    flex-direction: column;
}

/* ── 헤더 (h=72) ── */
.chat-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    padding: 0 56px;
    background-color: rgba(245, 237, 224, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(90, 60, 20, 0.1);
    flex-shrink: 0;
}

.chat-status-row {
    flex-direction: row;
    align-items: center;
}

/* ── 메인 2분할 ── */
.chat-main {
    flex: 1;
    flex-direction: row;
}

/* 좌측 대화 패널 (860px) */
.chat-left {
    width: 860px;
    flex-direction: column;
    padding: 44px 52px 36px;
    border-right-width: 1px;
    border-right-color: rgba(90, 60, 20, 0.07);
    justify-content: space-between;
}

/* ScrollView 대화 영역 */
.chat-scroll {
    flex: 1;
}

.chat-bubble-list {
    flex-direction: column;
    padding: 0 0 24px;
}

/* 생각 중 인디케이터 */
.chat-thinking {
    flex-direction: row;
    align-items: center;
    padding: 12px 0;
    align-self: flex-start;
}

.thinking-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgb(177, 74, 46);
    margin: 0 4px;
    opacity: 0.4;
    transition: opacity 0.3s;
}

/* 좌측 하단 입력 영역 */
.chat-input-area {
    flex-direction: column;
    flex-shrink: 0;
}

/* 우측 마스코트 패널 */
.chat-right {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
}

/* 후광 */
.chat-mascot-halo {
    position: absolute;
    bottom: -40px;
    left: 50%;
    translate: -50% 0%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background-color: rgba(200, 64, 48, 0.05);
}

/* 단청 원 640 */
.chat-dancheong-ring {
    position: absolute;
    bottom: 60px;
    left: 50%;
    translate: -50% 0%;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    border-width: 1.5px;
    border-color: rgba(200, 64, 48, 0.05);
}

/* 마스코트 슬롯 */
.chat-mascot-slot {
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background-color: rgba(200, 64, 48, 0.02);
    position: relative;
}

/* AI 처리 중 타이핑 점 */
.mascot-emote-dots {
    position: absolute;
    bottom: 80px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    display: none;
}

.mascot-emote-dots__dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(177, 74, 46);
    margin-left: 6px;
    margin-right: 6px;
    transition-property: translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out;
}


