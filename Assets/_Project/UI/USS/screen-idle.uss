/* Idle Screen — 대기 화면 터치 유도 (UNITY_DESIGN_SPEC §3.3) */

.idle-root {
    flex-direction: column;
}

/* ── 헤더 (h=90) ── */
.idle-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 90px;
    padding: 0 72px;
    flex-shrink: 0;
}

.idle-header-chips {
    flex-direction: row;
    align-items: center;
}

/* ── 메인 영역 (3분할) ── */
.idle-main {
    flex: 1;
    flex-direction: row;
    align-items: stretch;
}

/* 좌측 환영 메시지 (600px) */
.idle-welcome {
    width: 600px;
    flex-direction: column;
    justify-content: center;
    padding: 0 0 0 80px;
}

.idle-location-badge {
    flex-direction: row;
    align-items: center;
    padding: 8px 24px;
    background-color: rgba(200, 64, 48, 0.07);
    border-width: 1px;
    border-color: rgba(200, 64, 48, 0.2);
    border-radius: 40px;
    align-self: flex-start;
    margin-bottom: 24px;
}

.idle-location-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border-width: 1.5px;
    border-color: rgb(177, 74, 46);
    background-color: rgb(177, 74, 46);
    margin-right: 10px;
    flex-shrink: 0;
}

.idle-location-text {
    font-size: 15px;
    color: rgb(177, 74, 46);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.idle-welcome-headline {
    font-size: 76px;
    color: rgb(26, 18, 8);
    -unity-font-style: bold;
    margin-bottom: 24px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.idle-welcome-headline--accent {
    color: rgb(177, 74, 46);
}

.idle-welcome-en {
    font-size: 24px;
    color: rgb(74, 53, 32);
    margin-bottom: 8px;
}

.idle-welcome-intl {
    font-size: 20px;
    color: rgb(138, 112, 96);
}

/* 중앙 마스코트 (640px) */
.idle-mascot-area {
    width: 640px;
    align-items: center;
    justify-content: flex-end;
    position: relative;
}

.idle-mascot-halo {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0%;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background-color: rgba(200, 64, 48, 0.06);
}

/* 우측 CTA 영역 */
.idle-cta-area {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 60px 0 20px;
}

/* 터치 CTA 카드 */
.idle-touch-card {
    width: 100%;
    flex-direction: column;
    align-items: center;
    padding: 56px 40px;
    background-color: rgba(200, 64, 48, 0.1);
    border-width: 3px;
    border-color: rgba(200, 64, 48, 0.45);
    border-radius: 32px;
    margin-bottom: 36px;
    transition: opacity 0.5s;
}

/* 리플 영역 */
.touch-ripple-area {
    width: 120px;
    height: 120px;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 32px;
}

.touch-ripple {
    position: absolute;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(177, 74, 46);
}

/* 초기 opacity/scale은 C# 애니메이션에서 매 틱 설정 */
.touch-ripple--sm { width: 60px; height: 60px; opacity: 0; }
.touch-ripple--md { width: 90px; height: 90px; opacity: 0; }
.touch-ripple--lg { width: 120px; height: 120px; opacity: 0; }

.touch-center-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: rgba(200, 64, 48, 0.3);
    border-width: 2.5px;
    border-color: rgb(177, 74, 46);
    align-items: center;
    justify-content: center;
}

.idle-touch-main {
    font-size: 52px;
    color: rgb(26, 18, 8);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 14px;
}

.idle-touch-en {
    font-size: 26px;
    color: rgb(74, 53, 32);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.idle-touch-intl {
    font-size: 20px;
    color: rgb(138, 112, 96);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* 도트 3개 */
.idle-dots {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.idle-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgb(177, 74, 46);
    margin: 0 5px;
}

/* QR 보조 카드 */
.idle-qr-card {
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 20px 28px;
    background-color: rgba(255, 252, 245, 0.75);
    border-width: 1px;
    border-color: rgba(90, 60, 20, 0.1);
    border-radius: 20px;
}

.idle-qr-title {
    font-size: 17px;
    color: rgb(26, 18, 8);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.idle-qr-desc {
    font-size: 14px;
    color: rgb(138, 112, 96);
    white-space: normal;
}

/* ── 관리자 롱프레스 진행 인디케이터 (좌상단 절대배치) ── */
.admin-lp-track {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 140px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(90, 60, 20, 0.18);
    overflow: hidden;
}

.admin-lp-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(177, 74, 46);
    border-radius: 3px;
}

