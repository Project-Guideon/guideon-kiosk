<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- GUIDEON 로고 컴포넌트 (G 마크 + 워드마크 + 서브타이틀) -->
    <ui:VisualElement name="guideon-logo" class="logo-group">
        <!-- G 마크 원 (SVG는 VectorImage로 설정, 여기선 레이아웃만) -->
        <ui:VisualElement name="g-mark-container" style="width: 42px; height: 42px; border-radius: 50%; background-color: rgba(200,64,48,0.08); border-width: 1.5px; border-color: rgb(177,74,46); align-items: center; justify-content: center; margin-right: 16px; flex-shrink: 0;">
            <ui:Label name="g-mark-letter" text="G" style="font-size: 24px; color: rgb(177,74,46); -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:VisualElement name="wordmark-group" style="flex-direction: column;">
            <ui:Label name="wordmark" text="GUIDEON" class="logo-wordmark" />
            <ui:Label name="logo-sub" text="경복궁 AI 안내 시스템" class="logo-sub" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
